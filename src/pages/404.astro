---
import Base from '../layouts/Base.astro';
---
<Base
  title="Pagina niet gevonden — TopBoeken"
  description="Deze pagina bestaat niet of is verplaatst."
>
  <div style="max-width:600px;margin:80px auto 120px;padding:0 24px;text-align:center">
    <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#bbb;margin-bottom:20px">404</div>
    <h1 style="font-size:42px;font-weight:400;letter-spacing:-1px;line-height:1.1;margin-bottom:16px">
      Pagina niet <span class="sans">gevonden</span>
    </h1>
    <p style="font-size:16px;line-height:1.8;color:#666;margin-bottom:40px">
      Deze pagina bestaat niet of is verplaatst.<br>
      Zoek een boek of ga terug naar de homepage.
    </p>
    <form action="/zoeken" method="get" style="display:flex;gap:8px;justify-content:center;margin-bottom:24px">
      <input
        name="q"
        placeholder="Zoek een boek of auteur…"
        style="padding:10px 16px;border:1.5px solid #ddd;background:#fff;font-family:inherit;font-size:15px;width:280px"
      />
      <button type="submit"
        style="padding:10px 20px;background:#232323;color:#fff;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;border:none;cursor:pointer">
        Zoeken
      </button>
    </form>
    <a href="/" style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#888;text-decoration:underline">
      ← Terug naar de homepage
    </a>
  </div>
</Base>
