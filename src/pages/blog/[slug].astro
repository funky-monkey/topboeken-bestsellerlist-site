---
import Base from '../../layouts/Base.astro';
import { getAllArticles, getArticleBySlug, getBooksForArticle } from '../../lib/articles.js';
import { titleCase } from '../../lib/text-utils.js';
import '../../styles/article.css';

export async function getStaticPaths() {
  return getAllArticles({ publishedOnly: true }).map(a => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = getArticleBySlug(slug);
if (!article) return Astro.redirect('/blog');

const books = getBooksForArticle(article.id);

function formatDate(str) {
  if (!str) return '';
  return new Date(str).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function stars(rating) {
  const full  = Math.floor(rating);
  const half  = rating - full >= 0.25 && rating - full < 0.75;
  const empty = 5 - full - (half ? 1 : 0);
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
}
---
<Base
  title={`${article.title} — TopBoeken`}
  description={article.intro?.slice(0, 160) ?? `Leeslijst: ${article.title}`}
  canonical={`https://top-boeken.nl/blog/${article.slug}`}
  ogType="article"
  editUrl={`/admin/articles/${article.id}`}
>
  <div class="article-wrap">
    <div class="article-header">
      <div class="article-label">TopBoeken Leeslijst</div>
      <h1 class="article-title">{article.title}</h1>
      <div class="article-meta">
        {formatDate(article.published_at ?? article.created_at)}
        &nbsp;·&nbsp; {books.length} boeken
      </div>
    </div>

    {article.intro && (
      <div class="article-intro">
        {article.intro.split('\n').map(line => <>{line}<br /></>)}
      </div>
    )}

    <div class="article-books">
      {books.map(book => (
        <div class="article-book">
          <div class="article-book-cover">
            {book.cover_path
              ? <img src={`/${book.cover_path}`} alt={book.title} loading="lazy" />
              : <div class="article-book-cover-placeholder" />
            }
          </div>
          <div class="article-book-info">
            <a href={`/boeken/${book.slug}`} class="article-book-title">{titleCase(book.title)}</a>
            <div class="article-book-author">{book.author}</div>
            {book.goodreads_rating && (
              <div class="article-book-rating">
                <span class="article-book-stars">{stars(book.goodreads_rating)}</span>
                <span class="article-book-rating-num">{Number(book.goodreads_rating).toFixed(1)}</span>
                {book.goodreads_count && (
                  <span class="article-book-rating-count">({book.goodreads_count.toLocaleString('nl-NL')} beoordelingen)</span>
                )}
              </div>
            )}
            {book.article_description && (
              <p class="article-book-desc">
                {book.article_description.split('\n').map(line => <>{line}<br /></>)}
              </p>
            )}
            <div class="article-book-buy">
              {book.bol_url && <a href={book.bol_url} target="_blank" rel="noopener nofollow">Kopen bij bol.com</a>}
              {book.amazon_url && <a href={book.amazon_url} target="_blank" rel="noopener nofollow">Kopen bij Amazon</a>}
              <a href={`/boeken/${book.slug}`}>Meer info</a>
            </div>
          </div>
        </div>
      ))}
    </div>

    {article.outro && (
      <div class="article-outro">
        {article.outro.split('\n').map(line => <>{line}<br /></>)}
      </div>
    )}
  </div>
</Base>
