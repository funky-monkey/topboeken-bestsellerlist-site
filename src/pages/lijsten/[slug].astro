---
import '../../styles/source-row.css';
import '../../styles/list-sublists.css';
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import BookCardBig from '../../components/BookCardBig.astro';
import { getAllSources, getSourceBySlug, getFullListForSource } from '../../lib/data.js';

export async function getStaticPaths() {
  return getAllSources().map(s => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const source = getSourceBySlug(slug);
const books  = getFullListForSource(slug, 500);
const flagMap = { NL: '🇳🇱', US: '🇺🇸', INT: '🌐' };

// Group books by sublist name, preserving rank order
const sublists = books.reduce((acc, book) => {
  const key = book.list_name ?? source.name;
  if (!acc[key]) acc[key] = [];
  acc[key].push(book);
  return acc;
}, {});

const hasMultipleSublists = Object.keys(sublists).length > 1;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${source.name} Bestsellers`,
  url: `https://top-boeken.nl/lijsten/${slug}`,
  itemListElement: books.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://top-boeken.nl/boeken/${b.slug}`,
  })),
};
---
<Base
  title={`${source.name} Bestsellers — Volledige lijst`}
  description={`De volledige bestsellerlijst van ${source.name}. Alle titels op één pagina.`}
  canonical={`/lijsten/${slug}`}
  jsonLd={jsonLd}
>
  <div class="list-page-header">
    <h1 class="list-page-title">
      De <span class="sans">{source.name}</span> Lijst
      <span class="list-page-flag">{flagMap[source.country] ?? ''}</span>
    </h1>
    {hasMultipleSublists && (
      <p class="list-page-subtitle">{Object.keys(sublists).length} categorieën · {books.length} boeken</p>
    )}
  </div>

  {hasMultipleSublists ? (
    Object.entries(sublists).map(([listName, listBooks]) => {
      const [first, ...rest] = listBooks;
      return (
        <div class="sublist-section">
          <div class="sublist-header">
            <div class="source-accent" style={`background:${source.accent_color}`}></div>
            <h2 class="sublist-title">
              <span class="sans">{listName}</span>
            </h2>
            <span class="sublist-count">{listBooks.length} titels</span>
          </div>
          <div class="book-grid sublist-grid">
            {first && <BookCardBig book={first} accentColor={source.accent_color} />}
            {rest.map(b => <BookCard book={b} accentColor={source.accent_color} />)}
          </div>
        </div>
      );
    })
  ) : (
    (() => {
      const [first, ...rest] = books;
      return (
        <div class="book-grid sublist-grid">
          {first && <BookCardBig book={first} accentColor={source.accent_color} />}
          {rest.map(b => <BookCard book={b} accentColor={source.accent_color} />)}
        </div>
      );
    })()
  )}
</Base>
