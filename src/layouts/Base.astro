---
import Nav from '../components/Nav.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';

const { title, description, canonical, ogImage, ogType, jsonLd, preloadImage, editUrl } = Astro.props;
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    ogType={ogType}
    jsonLd={jsonLd}
    preloadImage={preloadImage}
  />
  <link rel="stylesheet" href="/admin-bar.css" />
</head>
<body data-edit-url={editUrl ?? ''}>
  <div class="site-wrap">
    <Nav />
    <main>
      <slot />
    </main>
  </div>
  <footer style="border-top:1px solid var(--border);padding:24px 0;margin-top:64px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#aaa;text-align:center;">
    © {new Date().getFullYear()} TopBoeken
  </footer>
  <script>
    // Load admin bar dynamically — avoids Astro bundling the public asset
    const s = document.createElement('script');
    s.src = '/scripts/admin-bar.js';
    document.head.appendChild(s);
  </script>
</body>
</html>
